{
  "name": "shape-to-query",
  "private": "true",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "postinstall": "patch-package",
    "lint": "eslint . --quiet",
    "test:query": "c8 -o coverage/query --all --reporter=lcov --reporter=text mocha packages/shape-to-query/test/store.test.ts",
    "test:unit": "c8 -o coverage/unit --all --reporter=lcov --reporter=text mocha --recursive packages/**/*.test.ts --exclude packages/shape-to-query/test/store.test.ts",
    "test": "npm run test:query && npm run test:unit",
    "prebuild": "npm run docs",
    "build": "npm run -w packages/demo build",
    "build:spec": "docker compose run --rm bikeshed --allow-nonlocal-files spec",
    "docs": "find packages/demo/public -type f -name index.bs -exec npm run build:spec -- {} \\;",
    "docs:watch": "docker compose run --rm --publish 8000:8000 bikeshed --allow-nonlocal-files serve",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@rdfjs/types": "^2",
    "@tpluscode/eslint-config": "^4.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25",
    "@types/sinon-chai": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "c8": "^12.0.0",
    "eslint": "^10.11.0",
    "globals": "^15",
    "husky": "^9.1.4",
    "jest-resolve": "^29.5.0",
    "lint-staged": "^15",
    "mocha": "^12",
    "patch-package": "^8.0.1",
    "sinon-chai": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix --quiet"
    ]
  },
  "madge": {
    "detectiveOptions": {
      "ts": {
        "skipTypeImports": true
      }
    }
  }
}
