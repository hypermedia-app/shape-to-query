PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>
CONSTRUCT {
  ?resource1 rdf:type schema:Person.
  ?resource1 schema:email ?resource2.
}
WHERE {
  ?resource1 rdf:type schema:Person;
    schema:email ?resource2.
  FILTER(EXISTS {
    SELECT ?resource1 WHERE { ?resource1 schema:email ?resource5. }
    GROUP BY ?resource1
    HAVING ((COUNT(DISTINCT ?resource5)) >= 2 )
  })
}